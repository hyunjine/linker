# infra 스크립트 공용 환경변수. 실제 값은 .env 로 복사해 채우고, .env 는 gitignore 대상.
# 사용: `source infra/.env` → `infra/setup-*.sh` 실행

# ── GCP 프로젝트 ──
export PROJECT_ID="linker-prod"           # 실제 GCP 프로젝트 ID
export REGION="asia-northeast3"           # 서울

# ── Artifact Registry ──
export AR_REPO="linker-images"            # 컨테이너 이미지 저장소 이름
export SERVICE_NAME="linker-api"          # Cloud Run 서비스 + 이미지 이름

# ── Cloud SQL ──
export SQL_INSTANCE="linker-pg"           # 인스턴스 이름
export SQL_DB="linker"                    # 데이터베이스 이름
export SQL_USER="linker"                  # DB 사용자
export SQL_TIER="db-f1-micro"             # 인스턴스 크기 (개발/초기용). 프로덕션은 db-custom-*.
export SQL_DB_VERSION="POSTGRES_16"

# ── Cloud Run 서비스 계정 ──
export RUN_SA_NAME="linker-run"           # 짧은 SA 이름
export RUN_SA_EMAIL="${RUN_SA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"

# ── 카카오 (사용자가 카카오 콘솔에서 발급 후 채움) ──
# infra/setup-secrets.sh 가 이 값을 Secret Manager 에 밀어넣는다.
export KAKAO_REST_API_KEY=""              # ex) 5f3e...

# ── JWT ──
# 비워두면 setup-secrets.sh 가 openssl rand -hex 32 로 자동 생성한다.
export JWT_SECRET=""
