<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 특일정보 API · Supabase PostgREST 호출용. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ 알림 표시 권한. 런타임 요청 필요. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LinkerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustPan">
            <!--
              adjustPan: IME 가 뜰 때 창 크기를 그대로 두고 콘텐츠만 위로 이동.
              기본 adjustResize 는 창 크기 자체가 줄어 캘린더 등 fillMaxSize 화면이
              세로로 튀었다 돌아오는 문제 발생 (#109). Compose 는 IME 인셋을 별도로
              읽어 `imePadding()` 등에서 사용 가능하므로 조합 문제 없음.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCM 토큰 refresh · foreground push 수신. -->
        <service
            android:name=".push.LinkerFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          MSAL (Outlook 로그인) redirect callback.
          scheme + host + path 세 값이 Azure Portal 에 등록된 Android Redirect URI
          와 정확히 일치해야 한다:
            msauth://com.hyunjine.linker/myvj9EztmeEdfcIg7MfUwOAbG58%3D
          path 는 URL-encoded 서명 해시 (debug keystore SHA1 → base64 → %3D 이스케이프).
          release 서명이 다르므로 release 빌드 준비 시 별도 <data> 추가 필요.
        -->
        <activity
            android:name="com.microsoft.identity.client.BrowserTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="msauth"
                    android:host="com.hyunjine.linker"
                    android:path="/myvj9EztmeEdfcIg7MfUwOAbG58%3D" />
            </intent-filter>
        </activity>

    </application>

    <!-- MSAL 이 Chrome Custom Tab 을 띄우기 위해 브라우저 패키지 가시성 요구 (Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

</manifest>
