<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 특일정보 API · Supabase PostgREST · Kakao SDK 호출용. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ 알림 표시 권한. 런타임 요청 필요. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Android 11+ 에서 카카오톡 앱 존재 여부를 조회하려면 명시적 queries 필요.
      없으면 isKakaoTalkLoginAvailable() 이 항상 false 반환 → 매번 웹 로그인으로 폴백.
    -->
    <queries>
        <package android:name="com.kakao.talk" />
    </queries>

    <application
        android:name=".LinkerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustPan">
            <!--
              adjustPan: IME 가 뜰 때 창 크기를 그대로 두고 콘텐츠만 위로 이동.
              기본 adjustResize 는 창 크기 자체가 줄어 캘린더 등 fillMaxSize 화면이
              세로로 튀었다 돌아오는 문제 발생 (#109). Compose 는 IME 인셋을 별도로
              읽어 `imePadding()` 등에서 사용 가능하므로 조합 문제 없음.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          카카오 로그인 콜백 액티비티. 카카오톡/카카오 계정에서 인증 후
          kakao{NATIVE_APP_KEY}://oauth 스킴으로 우리 앱에 돌아온다.
          scheme placeholder 는 androidApp/build.gradle.kts 의 manifestPlaceholders 로 주입.
        -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="oauth"
                    android:scheme="kakao${KAKAO_NATIVE_APP_KEY}" />
            </intent-filter>
        </activity>

        <!-- FCM 토큰 refresh · foreground push 수신. -->
        <service
            android:name=".push.LinkerFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
