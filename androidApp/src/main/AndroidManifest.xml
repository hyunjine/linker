<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 특일정보 API · Supabase Auth OAuth · PostgREST 호출용. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".LinkerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!--
          Supabase Auth OAuth 콜백을 우리 앱으로 돌려받기 위한 딥링크.
          Chrome Custom Tab 에서 카카오 로그인이 끝나면 Supabase 가
          com.hyunjine.linker://auth-callback?... 로 리다이렉트 → 이 액티비티가 캐치.
          singleTask 로 기존 인스턴스에 onNewIntent 로 전달돼 세션 복원 후 홈으로.
        -->
        <activity
            android:exported="true"
            android:launchMode="singleTask"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="auth-callback"
                    android:scheme="com.hyunjine.linker" />
            </intent-filter>
        </activity>
    </application>

</manifest>
