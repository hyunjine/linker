<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.hyunjine.linker.kakao</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kakao$(KAKAO_NATIVE_APP_KEY)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.319241271170-m6kj85v1smlad0p75g7kcsevd5lk889t</string>
			</array>
		</dict>
	</array>
	<key>KAKAO_NATIVE_APP_KEY</key>
	<string>$(KAKAO_NATIVE_APP_KEY)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>kakaokompassauth</string>
		<string>kakaolink</string>
	</array>
	<!-- Silent Push (content-available: 1) 를 백그라운드에서 받으려면 필수 (#194).
	     매일 KST 자정에 서버가 발송해 앱을 잠깐 깨워 위젯 payload 를 갱신한다. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- SwiftUI @UIApplicationDelegateAdaptor 는 iOSApp.init 시점엔 delegate 를 UIApplication
	     에 attach 하지 않아 Firebase 의 auto-swizzling 이 실패한다 ("App Delegate does not
	     conform to UIApplicationDelegate protocol" 경고 → APNs token 이 Firebase 로 전달
	     안 됨 → FCM 토큰 발급 실패). NO 로 명시적으로 꺼서 우리가 AppDelegate 에서 수동으로
	     Messaging.messaging().apnsToken 을 세팅. Firebase 공식 권장 SwiftUI 통합 패턴. -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
</dict>
</plist>
