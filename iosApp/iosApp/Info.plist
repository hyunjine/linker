<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.319241271170-m6kj85v1smlad0p75g7kcsevd5lk889t</string>
			</array>
		</dict>
		<!-- MSAL (Outlook 로그인) redirect URI scheme. Azure Portal 에 등록된
		     `msauth.com.hyunjine.linker://auth` 와 매칭. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>msal</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>msauth.com.hyunjine.linker</string>
			</array>
		</dict>
	</array>
	<!-- msauthv2/msauthv3 (Microsoft Authenticator broker 감지용 쿼리 스킴).
	     최신 MSAL SDK 는 MSALPublicClientApplication 초기화 단계에서 이 두 스킴 등록을
	     필수 검증한다 (없으면 init 실패 → "The required query schemes ... are not registered").
	     broker 위임으로 인한 stuck 은 OutlookAuthProvider.acquireInteractive 에서
	     webviewType = .authenticationSession 강제로 별도 차단하므로, 여기 스킴 등록은
	     init 통과 용도이며 runtime 에서 broker 가 호출되지 않는다. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>msauthv2</string>
		<string>msauthv3</string>
	</array>
	<!-- Silent Push (content-available: 1) 를 백그라운드에서 받으려면 필수 (#194).
	     매일 KST 자정에 서버가 발송해 앱을 잠깐 깨워 위젯 payload 를 갱신한다. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- SwiftUI @UIApplicationDelegateAdaptor 는 iOSApp.init 시점엔 delegate 를 UIApplication
	     에 attach 하지 않아 Firebase 의 auto-swizzling 이 실패한다 ("App Delegate does not
	     conform to UIApplicationDelegate protocol" 경고 → APNs token 이 Firebase 로 전달
	     안 됨 → FCM 토큰 발급 실패). NO 로 명시적으로 꺼서 우리가 AppDelegate 에서 수동으로
	     Messaging.messaging().apnsToken 을 세팅. Firebase 공식 권장 SwiftUI 통합 패턴. -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
</dict>
</plist>
