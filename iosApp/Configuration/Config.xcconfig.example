// iosApp/Configuration/Config.xcconfig 템플릿.
//
// 다른 맥에서 클론 직후 이 파일을 참고해 `Config.xcconfig` 를 만드세요.
//   1) cp iosApp/Configuration/Config.xcconfig.example iosApp/Configuration/Config.xcconfig
//   2) 아래 값들을 실제 값으로 교체
//
// 실제 `Config.xcconfig` 는 .gitignore 되어 저장소에 안 들어갑니다.

// Apple 개발자 팀 ID. Xcode → Settings → Accounts → Team 컬럼 (10자리 문자열).
// 실기기 signing 에 필요. 시뮬레이터만 돌릴 거면 임의값이어도 무방.
TEAM_ID=XXXXXXXXXX

// 앱 표시 이름 · Bundle ID · 버전. 팀별로 바꿀 필요 없음.
PRODUCT_NAME=Linker
PRODUCT_BUNDLE_IDENTIFIER=com.hyunjine.linker

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// Kakao 네이티브 앱 키. Info.plist 의 $(KAKAO_NATIVE_APP_KEY) 로 치환됨.
// local.properties 의 kakao.native.app.key 와 동일한 값을 넣으세요.
// https://developers.kakao.com/console/app → 앱 선택 → 앱 키 → "네이티브 앱 키"
KAKAO_NATIVE_APP_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
